# Flask & Security
FLASK_ENV=production
SECRET_KEY=your_super_secret_key_change_me_in_production
JWT_SECRET_KEY=your_super_secret_jwt_key_change_me_in_production
JWT_EXPIRES_SECONDS=86400

# MongoDB Atlas URI (Use Atlas for cloud deployment on Render)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://dbUser:dbPassword@cluster0.mongodb.net/mechanic_finder_db?retryWrites=true&w=majority

# Uploads Configuration
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# Optional: Email Service
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=

# Optional: Redis
# REDIS_URL=redis://localhost:6379/0

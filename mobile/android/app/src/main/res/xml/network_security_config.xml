<?xml version="1.0" encoding="utf-8"?>
<!--
  Allows clear-text (HTTP) traffic to the local Flask backend.
  The android:usesCleartextTraffic="true" in AndroidManifest.xml already
  handles API 28+ globally, but this file gives fine-grained control.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Android emulator → host machine -->
        <domain includeSubdomains="true">10.0.2.2</domain>
        <!-- Physical device on local network (PC's Wi-Fi IP) -->
        <domain includeSubdomains="true">192.168.100.115</domain>
        <domain includeSubdomains="true">192.168.100.102</domain>
        <domain includeSubdomains="true">192.168.100.101</domain>
        <domain includeSubdomains="true">192.168.18.18</domain>
        <domain includeSubdomains="true">192.168.18.67</domain>
        <domain includeSubdomains="true">192.168.18.36</domain>
        <domain includeSubdomains="true">192.168.1.1</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
</network-security-config>

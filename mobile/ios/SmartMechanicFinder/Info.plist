<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>

  <key>CFBundleDisplayName</key>
  <string>GetFix</string>

  <key>CFBundleExecutable</key>
  <string>$(EXECUTABLE_NAME)</string>

  <key>CFBundleIdentifier</key>
  <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>

  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>

  <key>CFBundleName</key>
  <string>GetFix</string>

  <key>CFBundlePackageType</key>
  <string>APPL</string>

  <key>CFBundleShortVersionString</key>
  <string>1.0</string>

  <key>CFBundleSignature</key>
  <string>????</string>

  <key>CFBundleVersion</key>
  <string>1</string>

  <key>LSRequiresIPhoneOS</key>
  <true/>

  <key>NSAppTransportSecurity</key>
  <dict>
    <!-- Allow HTTP connections to local backend (dev only) -->
    <key>NSAllowsArbitraryLoads</key>
    <true/>
    <key>NSAllowsLocalNetworking</key>
    <true/>
    <key>NSExceptionDomains</key>
    <dict>
      <key>localhost</key>
      <dict>
        <key>NSExceptionAllowsInsecureHTTPLoads</key>
        <true/>
      </dict>
    </dict>
  </dict>

  <!-- Location Permissions -->
  <key>NSLocationWhenInUseUsageDescription</key>
  <string>GetFix needs your location to find mechanics near you.</string>

  <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
  <string>GetFix uses your location in the background to enable SOS emergency features.</string>

  <key>NSLocationAlwaysUsageDescription</key>
  <string>GetFix uses your location to find nearby mechanics and for SOS emergency features.</string>

  <!-- Camera Permission -->
  <key>NSCameraUsageDescription</key>
  <string>GetFix needs camera access to upload photos of your vehicle for mechanics.</string>

  <!-- Photo Library Permissions -->
  <key>NSPhotoLibraryUsageDescription</key>
  <string>GetFix needs access to your photo library to upload vehicle photos.</string>

  <key>NSPhotoLibraryAddUsageDescription</key>
  <string>GetFix saves vehicle photos to your photo library.</string>

  <!-- Microphone (for future video features) -->
  <key>NSMicrophoneUsageDescription</key>
  <string>GetFix may use the microphone for video features.</string>

  <!-- Push Notifications -->
  <key>UIBackgroundModes</key>
  <array>
    <string>remote-notification</string>
    <string>location</string>
    <string>fetch</string>
  </array>

  <!-- Google Maps API Key -->
  <!-- Replace YOUR_API_KEY_HERE with your real key from console.cloud.google.com -->
  <key>GMSApiKey</key>
  <string>YOUR_API_KEY_HERE</string>

  <key>UILaunchStoryboardName</key>
  <string>LaunchScreen</string>

  <key>UIRequiredDeviceCapabilities</key>
  <array>
    <string>armv7</string>
  </array>

  <key>UISupportedInterfaceOrientations</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>

  <key>UISupportedInterfaceOrientations~ipad</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationPortraitUpsideDown</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>

  <key>UIViewControllerBasedStatusBarAppearance</key>
  <false/>
</dict>
</plist>
